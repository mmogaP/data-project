# Copy to .env (dagster dev loads it). Paths are relative to the repo root.

# Raw landing zone. Local path today; a gs://bucket URI works too (pyarrow resolves it).
# RAW_ROOT=data/raw

# Folder for per-client DuckDB warehouses (dbt dev target).
# WAREHOUSE_ROOT=data/warehouse

# dbt target: dev (DuckDB, local) | prod (BigQuery, not wired yet)
DBT_TARGET=dev

# Salt for dbt_core.hash_pii. Use a real secret outside local dev.
PII_SALT=local-dev-salt
